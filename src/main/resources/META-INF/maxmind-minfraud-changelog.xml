<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="maxmind-minfraud-1.0.0" author="zymlabs">
        <comment>Create MaxMind minFraud check table</comment>

        <createTable tableName="maxmind_minfraud_check">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="user_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>

            <column name="realm_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>

            <column name="username" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>

            <column name="email" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>

            <column name="ip_address" type="VARCHAR(45)">
                <constraints nullable="false"/>
            </column>

            <column name="timestamp" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="risk_score" type="DOUBLE">
                <constraints nullable="false"/>
            </column>

            <column name="decision" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="device_session_id" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>

            <column name="request_id" type="VARCHAR(36)">
                <constraints nullable="true"/>
            </column>

            <column name="raw_response" type="TEXT">
                <constraints nullable="true"/>
            </column>

            <column name="service_level" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>

            <column name="error_message" type="TEXT">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <!-- Create indexes for performance -->
        <createIndex indexName="idx_user_id" tableName="maxmind_minfraud_check">
            <column name="user_id"/>
        </createIndex>

        <createIndex indexName="idx_realm_id" tableName="maxmind_minfraud_check">
            <column name="realm_id"/>
        </createIndex>

        <createIndex indexName="idx_timestamp" tableName="maxmind_minfraud_check">
            <column name="timestamp"/>
        </createIndex>

        <createIndex indexName="idx_user_timestamp" tableName="maxmind_minfraud_check">
            <column name="user_id"/>
            <column name="timestamp"/>
        </createIndex>

        <rollback>
            <dropTable tableName="maxmind_minfraud_check"/>
        </rollback>
    </changeSet>

    <changeSet id="maxmind-minfraud-1.1.0" author="zymlabs">
        <comment>Add event_id column to link fraud checks with Keycloak events</comment>

        <addColumn tableName="maxmind_minfraud_check">
            <column name="event_id" type="VARCHAR(36)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <createIndex indexName="idx_event_id" tableName="maxmind_minfraud_check">
            <column name="event_id"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_event_id" tableName="maxmind_minfraud_check"/>
            <dropColumn tableName="maxmind_minfraud_check" columnName="event_id"/>
        </rollback>
    </changeSet>

    <changeSet id="maxmind-minfraud-1.2.0" author="zymlabs">
        <comment>Add pre-authentication mode support</comment>

        <!-- Make user_id nullable to support pre-auth checks -->
        <dropNotNullConstraint tableName="maxmind_minfraud_check" columnName="user_id"/>

        <!-- Add session_id for correlation -->
        <addColumn tableName="maxmind_minfraud_check">
            <column name="session_id" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <!-- Add flag to identify pre-auth checks -->
        <addColumn tableName="maxmind_minfraud_check">
            <column name="is_pre_auth" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <!-- Add timestamp for when correlation happened -->
        <addColumn tableName="maxmind_minfraud_check">
            <column name="correlated_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <!-- Add index on session_id for fast correlation lookups -->
        <createIndex indexName="idx_session_id" tableName="maxmind_minfraud_check">
            <column name="session_id"/>
        </createIndex>

        <!-- Add composite index for pre-auth correlation queries -->
        <createIndex indexName="idx_preauth_session" tableName="maxmind_minfraud_check">
            <column name="is_pre_auth"/>
            <column name="session_id"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_preauth_session" tableName="maxmind_minfraud_check"/>
            <dropIndex indexName="idx_session_id" tableName="maxmind_minfraud_check"/>
            <dropColumn tableName="maxmind_minfraud_check" columnName="correlated_at"/>
            <dropColumn tableName="maxmind_minfraud_check" columnName="is_pre_auth"/>
            <dropColumn tableName="maxmind_minfraud_check" columnName="session_id"/>
            <addNotNullConstraint tableName="maxmind_minfraud_check" columnName="user_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
